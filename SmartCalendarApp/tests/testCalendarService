const CalendarService = require("../src/services/CalendarService");
const CalendarView = require("../src/observers/CalendarView");
const WeeklySchedView = require("../src/observers/WeeklySchedView");

const service = new CalendarService();

const calendarView = new CalendarView();
const weeklyView = new WeeklySchedView();

// Register observers
service.addObserver(calendarView);
service.addObserver(weeklyView);

console.log("\nTesting updateViews()");

// Both observers should display events
service.updateViews();

console.log("\nTesting removeObserver()");

// Remove WeeklySchedView
service.removeObserver(weeklyView);

// Only CalendarView should display events
service.updateViews();